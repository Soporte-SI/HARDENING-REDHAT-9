#!/usr/sbin/nft -f
# {{ ansible_managed }}
# CIS RHEL9 4.3 - base chains, deny por defecto y trafico de loopback (rhel9_cis_hardening)

flush ruleset

table inet cis_filter {
    chain input {
        type filter hook input priority 0; policy drop;

        # 4.3.4 - trafico de loopback
        iif "lo" accept
        ip saddr 127.0.0.0/8 counter drop
        ip6 saddr ::1 counter drop

        # Conexiones establecidas/relacionadas
        ct state established,related accept

        # ICMP/ICMPv6 basico necesario para operacion de red
        ip protocol icmp accept
        ip6 nexthdr icmpv6 accept

        # SSH (ajustar segun politica de acceso del banco)
        tcp dport 22 accept
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}
